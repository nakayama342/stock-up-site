# 株式会社ストック・アップ サイト設定

Options -Indexes
ErrorDocument 404 /404.html

# ==== 削除済みページ（検索エンジンから除外させる） ====
<IfModule mod_alias.c>
  Redirect gone /news/2026-08-31.html
</IfModule>

# ==== https://stock-up.jp/ に統一(www なし・HTTPS)。SSL有効化済み(2026-09-17) ====
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.stock-up\.jp$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://stock-up.jp/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # HTTPS強制（1年間ブラウザに記憶させる）
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://www.google.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>
